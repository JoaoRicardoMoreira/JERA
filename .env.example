NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

DATABASE_URL=postgresql://finance_user:finance_password@localhost:5432/finance_control?schema=public
POSTGRES_DB=finance_control
POSTGRES_USER=finance_user
POSTGRES_PASSWORD=finance_password

TEST_DATABASE_URL=postgresql://finance_user:finance_password@localhost:5433/finance_control_test?schema=public
RUN_DATABASE_TESTS=false
POSTGRES_TEST_DB=finance_control_test
POSTGRES_TEST_USER=finance_user
POSTGRES_TEST_PASSWORD=finance_password

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=12
CORS_ORIGINS=http://localhost:4200

RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# Limites sensiveis fixos na aplicacao:
# auth register/login: 5 req/min; refresh/logout: 10 req/min; csv export: 20 req/min; csv import: 10 req/min.

SWAGGER_ENABLED=true
SWAGGER_PATH=/docs
