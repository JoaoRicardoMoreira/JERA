generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum RecurrenceStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @db.VarChar(120)
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  roles        Role[]    @default([USER])
  permissions  String[]  @default([]) @db.VarChar(120)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  refreshTokens RefreshToken[]
  categories    Category[]
  transactions  Transaction[]
  goals         Goal[]
  recurrences   Recurrence[]
  investmentConfig        InvestmentConfig?
  investmentContributions InvestmentContribution[]

  @@map("users")
}

model InvestmentConfig {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @unique @map("user_id") @db.Uuid
  monthlyRatePercent Decimal   @default(0) @map("monthly_rate_percent") @db.Decimal(8, 4)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_investment_configs_user_id")
  @@map("investment_configs")
}

model InvestmentContribution {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  amount    Decimal   @db.Decimal(14, 2)
  contributedAt DateTime @map("contributed_at")
  month     Int
  year      Int
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, year, month], map: "idx_investment_contributions_user_period")
  @@index([userId, contributedAt], map: "idx_investment_contributions_user_date")
  @@map("investment_contributions")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_refresh_tokens_user_id")
  @@index([expiresAt], map: "idx_refresh_tokens_expires_at")
  @@map("refresh_tokens")
}

model Category {
  id        String          @id @default(uuid()) @db.Uuid
  userId    String          @map("user_id") @db.Uuid
  name      String          @db.VarChar(80)
  type      TransactionType
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  deletedAt DateTime?       @map("deleted_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  goals        Goal[]
  recurrences  Recurrence[]

  @@unique([userId, name, type], map: "uq_categories_user_name_type")
  @@index([userId], map: "idx_categories_user_id")
  @@map("categories")
}

model Transaction {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String          @map("user_id") @db.Uuid
  categoryId  String?         @map("category_id") @db.Uuid
  amount      Decimal         @db.Decimal(14, 2)
  type        TransactionType
  description String?         @db.VarChar(255)
  occurredAt  DateTime        @map("occurred_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  deletedAt   DateTime?       @map("deleted_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt], map: "idx_transactions_user_occurred_at")
  @@index([userId, type], map: "idx_transactions_user_type")
  @@index([categoryId], map: "idx_transactions_category_id")
  @@map("transactions")
}

model Goal {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  categoryId String    @map("category_id") @db.Uuid
  amount     Decimal   @db.Decimal(14, 2)
  month      Int
  year       Int
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month, year], map: "uq_goals_user_category_period")
  @@index([userId, year, month], map: "idx_goals_user_period")
  @@index([categoryId], map: "idx_goals_category_id")
  @@map("goals")
}

model Recurrence {
  id              String              @id @default(uuid()) @db.Uuid
  userId          String              @map("user_id") @db.Uuid
  categoryId      String?             @map("category_id") @db.Uuid
  amount          Decimal             @db.Decimal(14, 2)
  type            TransactionType
  frequency       RecurrenceFrequency
  status          RecurrenceStatus    @default(ACTIVE)
  description     String?             @db.VarChar(255)
  startDate       DateTime            @map("start_date")
  endDate         DateTime?           @map("end_date")
  lastProcessedAt DateTime?           @map("last_processed_at")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  deletedAt       DateTime?           @map("deleted_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, status], map: "idx_recurrences_user_status")
  @@index([categoryId], map: "idx_recurrences_category_id")
  @@map("recurrences")
}
